# Basis data terkelola. Railway mengisi DATABASE_URL otomatis saat Postgres
# ditambahkan ke proyek. Jangan menaruh basis data di volume.
DATABASE_URL=postgresql://user:sandi@host:5432/budget

# Rahasia penandatanganan token. Wajib diganti di produksi.
JWT_SECRET=ganti-dengan-nilai-acak-panjang
JWT_TTL=12h

PORT=3000
# Alamat asal halaman web yang memanggil API ini - bukan alamat API-nya sendiri.
# Selama belum ada frontend, biarkan alamat pengembangan lokal Vite di bawah.
# Beberapa alamat dipisah koma tanpa spasi, dan tanpa garis miring di akhir.
CORS_ORIGIN=http://localhost:5173

# Penyimpanan objek untuk lampiran, terpisah dari basis data.
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=

# Dashboard Sales. Ditarik sekali sehari untuk histori Selling Out dan target per
# kota. Selama kosong, penarikan dilewati dan aplikasi tetap berjalan normal.
# Kontrak endpoint: docs/kontrak-endpoint-dashboard-sales.md
DASHBOARD_SALES_URL=
DASHBOARD_SALES_TOKEN=

# Gateway WhatsApp. Selama kosong, notifikasi hanya masuk ke dalam aplikasi dan
# tidak ada yang diantrekan. Pastikan vendor memakai Cloud API resmi Meta, dan
# gunakan nomor khusus notifikasi - terpisah dari nomor utama perusahaan.
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=

# Dipakai menyusun tautan di dalam pesan WhatsApp.
APP_URL=

# Direktori lampiran. Di Railway WAJIB berupa Volume yang di-mount ke /data,
# kalau tidak seluruh lampiran hilang setiap kali aplikasi di-deploy ulang.
LAMPIRAN_DIR=/data/lampiran
