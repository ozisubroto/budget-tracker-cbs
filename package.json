{
  "name": "budget-tracker-cbs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/lib/migrate.js",
    "seed:pengguna": "node src/lib/seedPengguna.js",
    "sandi:reset": "node src/lib/resetSandi.js",
    "cek": "node src/lib/cek.js",
    "uji:alur": "node uji/alur-approval.mjs",
    "uji:realisasi": "node uji/realisasi-lpj.mjs",
    "uji:laporan": "node uji/laporan.mjs",
    "uji:delegasi": "node uji/delegasi-notifikasi.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web ci && npm --prefix web run build",
    "uji:notifikasi": "node uji/notifikasi-lengkap.mjs",
    "uji:pengingat": "node uji/pengingat-menggantung.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5"
  }
}
